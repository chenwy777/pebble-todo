{
  "name": "pebble-todo",
  "version": "0.6.1",
  "description": "A quiet floating to-do companion for Windows and macOS.",
  "author": "Pebble contributors",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "prestart": "npm run build:voice",
    "build:voice": "node scripts/build-voice.cjs",
    "test": "node --test tests/domain.test.cjs tests/store.test.cjs tests/layout.test.cjs tests/ai.test.cjs tests/commands.test.cjs tests/skill.test.cjs",
    "build:mcp": "node mcp/build.cjs",
    "test:mcp": "node tests/mcp.cjs",
    "demo:record": "node scripts/record-demos.cjs",
    "prepack": "npm run build:mcp && npm run build:voice",
    "predist": "npm run build:mcp && npm run build:voice",
    "predist:win": "npm run build:mcp && npm run build:voice",
    "predist:mac": "npm run build:mcp && npm run build:voice",
    "test:desktop": "node tests/desktop.cjs",
    "test:features": "node tests/features.cjs",
    "test:voice-actions": "node tests/voice-actions.cjs",
    "test:skill": "node tests/skill-desktop.cjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis zip",
    "dist:mac": "electron-builder --mac dmg zip"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.12",
    "playwright": "1.64.1",
    "zod": "4.3.6"
  },
  "build": {
    "appId": "app.pebble.todo",
    "productName": "Pebble",
    "asar": true,
    "asarUnpack": [
      "node_modules/onnxruntime-node/**",
      "node_modules/onnxruntime-web/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "skills/**/*",
      "package.json",
      "!**/*.map",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**"
    ],
    "extraResources": [
      {
        "from": "mcp/dist",
        "to": "mcp"
      }
    ],
    "win": {
      "files": ["electron/**/*", "src/**/*", "assets/**/*", "skills/**/*", "package.json", "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**", "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**"],
      "artifactName": "Pebble-${version}-windows-${arch}.${ext}",
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "files": ["electron/**/*", "src/**/*", "assets/**/*", "skills/**/*", "package.json", "!node_modules/onnxruntime-node/bin/napi-v6/win32/**"],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Pebble uses the microphone only when you start voice input. Speech is recognized locally on your computer."
      },
      "artifactName": "Pebble-${version}-macos-${arch}.${ext}",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "darkModeSupport": true
    }
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "opencc-js": "1.0.5"
  }
}
