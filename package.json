{
  "name": "pebble-todo",
  "version": "0.5.0",
  "description": "A quiet floating to-do companion for Windows and macOS.",
  "author": "Pebble contributors",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/domain.test.cjs tests/store.test.cjs tests/layout.test.cjs tests/ai.test.cjs",
    "build:mcp": "node mcp/build.cjs",
    "test:mcp": "node tests/mcp.cjs",
    "prepack": "npm run build:mcp",
    "predist": "npm run build:mcp",
    "predist:win": "npm run build:mcp",
    "predist:mac": "npm run build:mcp",
    "test:desktop": "node tests/desktop.cjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis zip",
    "dist:mac": "electron-builder --mac dmg zip"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.12",
    "playwright": "1.64.1",
    "zod": "4.3.6"
  },
  "build": {
    "appId": "app.pebble.todo",
    "productName": "Pebble",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "mcp/dist",
        "to": "mcp"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "darkModeSupport": true
    }
  }
}
